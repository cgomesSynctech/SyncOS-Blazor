@model Modelos.ClienteHistorico

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var clienteId = int.Parse(ViewData["ClienteId"].ToString());
}



<h4>Novo Hostórico</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <form id="upload" name="upload" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <input type="file" name="file" value="Selecionar">
                    <button type="submit">Enviar</button>
                </div>

            </form>
        </div>
        <form asp-action="Create" id="formPrincipal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ClienteId" value="@Model.ClienteId"/>
            <input type="hidden" asp-for="UsuarioId" value="@Model.UsuarioId" />
            <input type="hidden" asp-for="Data" value="@Model.Data" />
            <div class="col-md-6">
                <label asp-for="Arquivo" class="control-label"></label>
                <input asp-for="Arquivo" class="form-control" id="pct" readonly="true" />

            </div>
            <div class="form-group">
                <label asp-for="Historico" class="control-label"></label>
                <textarea asp-for="Historico" type="text" class="form-control" rows="5" id="MessageInputField" autofocus></textarea>
                <span asp-validation-for="Historico" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                    </div>
                    <div class="col-md-6">
                        <a asp-action="Index" asp-route-page="0" asp-route-clienteId="@clienteId" class="btn btn-light btn-sm">Retornar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {

            $("#upload").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/Atualizacoes/UploadHistorico",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#formPrincipal input[name='Arquivo']").val(response.success);
                        alert("Arquivo " + response.success + ", enviado com sucesso!");
                    }
                });
            });
        });
    </script>

}

