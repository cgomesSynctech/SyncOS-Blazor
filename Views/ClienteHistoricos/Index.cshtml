@using Services
@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
@model X.PagedList.IPagedList<Modelos.ClienteHistorico>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var clienteId = int.Parse(ViewData["ClienteId"].ToString());
    var nomeCliente = ViewData["NomeCliente"].ToString();
    var perfil = int.Parse(ViewData["Perfil"].ToString());
    var cliProsp = int.Parse(ViewData["ClienteProsp"].ToString());
    
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <h2>Histórico <a asp-action="Create" asp-route-clienteId="@clienteId"><img src="~/img/ic_add.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /> </a></h2>

    <h4>Cliente: <b>@nomeCliente</b> </h4>
    <hr/>
 <table class="table table-responsive table-striped text-nowrap table-sm">
    <thead>
        <tr>
            <th>
                # Id
            </th>
            <th>
                Data
            </th>
            <th>
                Usuário
            </th>
            <th>
                Histórico
            </th>
            <th>
                Arquivo
            </th>

            <th>
                Ações
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario.LoginName)
            </td>
            <td class="text-truncate" style="max-width: 500px;">
                @Html.DisplayFor(modelItem => item.Historico)
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.Arquivo))
                {
                    <a href="~/historico/@item.Arquivo" target="_blank">
                        @item.Arquivo
                    </a>
                }
                else
                {
                    <span>Sem arquivo</span>
                }

            </td>

            <td>
                <a asp-action="Details" asp-controller="ClienteHistoricos" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/info.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
            </td>
        </tr>
}
    </tbody>
</table>
    <div>
        Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
    </div>

    @Html.PagedListPager(
    Model,
    pagina => Url.Action("Index", new { pagina, nomeCliente = nomeCliente}),
    new PagedListRenderOptions
    {
    DisplayItemSliceAndTotal = false,
    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
    ContainerDivClasses = new[] { "navigation" },
    PageClasses = new[] { "page-link" },
    LiElementClasses = new[] { "page-item" },
    UlElementClasses = new[] { "pagination justify-content-left" }
    }
    )

    <a asp-action="Index" asp-controller="Clientes" class="btn btn-light btn-sm">Lista Clientes</a>
    @if (@cliProsp > 0)
    {
        <a asp-controller="ClientesProspHistorico"
           asp-action="Index"
           asp-route-clienteId=@cliProsp class="btn btn-secondary bg-primary text-white"> Hist Prosp </a>
    }


</body>
</html>
