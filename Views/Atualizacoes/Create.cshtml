@model Modelos.Atualizacao

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<h2>Nova Atualização</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <form id="upload" name="upload" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <input type="file" name="file" value="Selecionar">
                    <button type="submit">Enviar</button>
                </div>
            </form>
        </div>
        <form asp-action="Create" id="formPrincipal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="Pacote" class="control-label"></label>
                        <input asp-for="Pacote" class="form-control" id="pct" readonly="true" />
                    </div>
                    <div class="col-md-6">
                        <label class="control-label">Descompactar Onde</label>
                        <input asp-for="PathDescompactar" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label  class="control-label">Data Versão</label>
                        <input asp-for="DataVersao" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DataVersao" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="control-label"># Versão</label>
                        <input asp-for="Versao" class="form-control" />
                        <span asp-validation-for="Versao" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CNPJ" class="control-label"></label>
                <input asp-for="CNPJ" class="form-control" />
                <span asp-validation-for="CNPJ" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Informação da Atualização</label>
                <textarea asp-for="LeiaMe" type="text" class="form-control" rows="3" id="MessageInputField" autofocus></textarea>
            </div>
            <div class="form-group">
                <label class="control-label">Script</label>
                <textarea asp-for="Script" type="text" class="form-control" rows="4" id="MessageInputField" autofocus></textarea>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label">Tipo</label>
                        <select asp-for="TipoAtualizacaoId" class="form-control" asp-items="ViewBag.TipoAtualizacaoId"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Backup" class="control-label"></label>
                        <input asp-for="Backup" class="form-control" />
                        <span asp-validation-for="Backup" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Ativo" class="control-label"></label>
                        <input asp-for="Ativo" class="form-control" />
                        <span asp-validation-for="Ativo" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                    </div>
                    <div class="col-md-6">
                        <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {

            $("#upload").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/Atualizacoes/Upload",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#formPrincipal input[name='Pacote']").val(response.success);
                        alert("Arquivo " + response.success + ", enviado com sucesso!");
                    }
                });
            });
        });
    </script>

}
