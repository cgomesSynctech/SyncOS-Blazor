@model Modelos.Chamado

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<h4>Atendimento Chamado</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ChamadoModuloId" />
            <input type="hidden" asp-for="ChamadoMotivoId" />
            <input type="hidden" asp-for="ChamadoFormaId" />
            <input type="hidden" asp-for="ChamadoPrioridadeId" />
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="TecnicoId" />
            <input type="hidden" asp-for="DataAbertura" />

            <div class="form-group">
                <label class="control-label">Cliente</label>
                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                 <label class="control-label">Modulo</label>
                 <select asp-for="ChamadoModuloId" class="form-control" asp-items="ViewBag.ChamadoModuloId"></select>
            </div>
            <div class="form-group">
                <label lass="control-label">Alegação Cliente</label>
                <textarea asp-for="AlegacaoCliente" type="text" class="form-control" rows="5"  readonly="true"></textarea>
                <span asp-validation-for="AlegacaoCliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label  class="control-label">Alegação Técnico</label>
                <textarea asp-for="AlegacaoTecnico" type="text" class="form-control" rows="5" id="MessageInputField"></textarea>
            </div>
            <div class="form-group">
                <label  class="control-label">Resolução</label>
                <textarea asp-for="Resolucao" type="text" class="form-control" rows="5" id="MessageInputField"></textarea>
            </div>
            <div class="form-group">
                <label class="control-label">Status</label>
                <select asp-for="ChamadoStatusId" class="form-control" asp-items="ViewBag.ChamadoStatusId"></select>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="Interlocutor" class="control-label"></label>
                        <input asp-for="Interlocutor" class="form-control" readonly="true"/>
                    </div>
                    <div class="col-md-6">
                        <label  class="control-label">Protocolo Autorização</label>
                        <input asp-for="ProtocoloAutorizacao" class="form-control" readonly="true" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-3">
                        <label class="control-label">Improcedente?</label>
                    </div>
                    <div class="col-md-3">
                        <input asp-for="IsImprocedente" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="control-label">Solucionado?</label>
                    </div>
                    <div class="col-md-3">
                        <input asp-for="IsSolucionado" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                    </div>
                    <div class="col-md-6">
                        <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
