@using System.Globalization;
@model Modelos.ClienteProsp

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<html lang="pt-br">
<body>
    <h2>Alterar Setor</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="AlteraSetor">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">Setor</label>
                            <select asp-for="SetorId" class="form-control" asp-items="ViewBag.SetorId"></select>
                        </div>
                    </div>
                </div>
               
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                        </div>
                        <div class="col-md-6">
                            <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
