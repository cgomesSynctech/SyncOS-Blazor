﻿@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
@model X.PagedList.IPagedList<Modelos.ClienteProsp>
@section AddToHead {

<style type="text/css">
    .pop-outer {
    background-color: rgba(0, 0, 0, 0.5);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    }

    .pop-inner {
    z-index: 1000;
    margin: 300px auto;
    padding: 10px;
    width: 148px;
    background-color: White;
    border-radius: 10px;
    filter: alpha(opacity=100);
    opacity: 1;
    -moz-opacity: 1;
    }

    .pop-inner img {
    height: 128px;
    width: 128px;
    }
</style>
}
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var setor = int.Parse(ViewData["Setor"].ToString());
    var status = int.Parse(ViewData["status"].ToString());
}
<h2>Lista Prospectos <a asp-action="Create"><img src="~/img/ic_add.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a></h2>
<form asp-action="Index" method="get" id="chamado" name="chamado">
    <div class="form-group">
        <div class="row">
            <div class="col-md-1">
                <span class="input-group-text"><strong>Status:</strong> </span>
            </div>
            <div class="col-md-3">
                <select id="status" name="status" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.ChamadoStatuId" onchange="selectStatus()"></select>
            </div>
            <div class="col-md-1">
                <span class="input-group-text"><strong>Setor:</strong> </span>
            </div>
            <div class="col-md-3">
                <select id="setor" name="setor" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.SetorId" onchange="selectStatus()"></select>
            </div>

        </div>
    </div>
</form>
<hr />

<div style="display: none;" class="pop-outer">
    <div class="pop-inner">
        <img alt="" src="~/gifs/progress.gif" />
    </div>
</div>

<table class="table table-responsive table-striped text-nowrap table-sm">
    <thead>
        <tr>
            <th style="text-align:center;">
                # Id
            </th>
            <th>
                Razao
            </th>
            <th>
                Fantasia
            </th>
            <th>
                CPF_CNPJ
            </th>
            <th>
                MunicipioId
            </th>
            <th>
                Status
            </th>
            <th>
                Vendedor
            </th>

            <th>
                Contato
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Razao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Fantasia)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CPF_CNPJ)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Municipio.Descricao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status.Descricao)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.Vendedor)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.Contato)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/img\icons\newIcons\Edit.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a> |
                    <a asp-action="Finalizar" asp-route-id="@item.Id"><img src="~/img/ic_broom.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
</div>

@Html.PagedListPager(
            Model,
            pagina => Url.Action("Index", new { pagina, setor, status }),
            new PagedListRenderOptions
        {
            DisplayItemSliceAndTotal = false,
            DisplayEllipsesWhenNotShowingAllPageNumbers = true,
            ContainerDivClasses = new[] { "navigation" },
            PageClasses = new[] { "page-link" },
            LiElementClasses = new[] { "page-item" },
            UlElementClasses = new[] { "pagination justify-content-left" }
        }
            )
<script>
    function selectStatus() {
        $('.pop-outer').fadeIn('slow');
        var id = document.getElementById("status");
        var setorId = document.getElementById("setor");
        id.value = id.value.toUpperCase();
        $.ajax({
            type: "GET",
            url: "/ClientesProsp/Index",
            data: "pagina=0&status=" + id.value + "&" + moduloId.value,
            success: function (status) {
                document.getElementById("chamado").submit();
            },
            error: function () {
                alert("Erro ao selecionar status.");
            }
        });
    }

    function showModal() {
        $('.pop-outer').fadeIn('slow');
    }

    function hideModal() {
        $('.pop-outer').fadeOut('slow');
    }

    window.onload = function () {
        hideModal();
    }

    $(document).ready(function () {

    });

</script>

