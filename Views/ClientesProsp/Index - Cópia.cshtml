@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    // var sort = @ViewData["NameSortParm"];
    var setor = int.Parse(ViewData["Setor"].ToString());
    var status = int.Parse(ViewData["status"].ToString());
}


<h2>Lista Prospecção <a asp-action="Create"><img src="~/img/ic_add.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a></h2>
<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            <input type="text" name="Filtro" placeholder="consulta" value="@ViewData["Filtro"]" />
            <input type="submit" value="Pesquisa" class="btn btn-secondary bg-primary text-white" />
            <a asp-action="Index" asp-route-ativo=0 class="btn btn-secondary bg-primary text-white"> Sem Filtro </a>
            <div class="row">
                <span class="input-group-text"><strong>Setor:</strong> </span>
                <div class="col-md-3">
                    <select id="setor" name="setor" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.SetorId" onchange="selectStatus()"></select>
                </div>
                <span class="input-group-text"><strong>Status:</strong> </span>
                <div class="col-md-3">
                    <select id="status" name="status" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.StatuId" onchange="selectStatus()"></select>
                </div>
            </div>

        </p>
    </div>
</form>
