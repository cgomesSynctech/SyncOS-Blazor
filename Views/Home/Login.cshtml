@model Modelos.Login

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout-Login.cshtml";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Sync Força Venda">
    <meta name="author" content="Synctech">
    <meta name="keyword" content="Sync Força Venda">
    <title>Login - Sync OS</title>


    <link href="~/css/fontawesome/css/all.css" rel="stylesheet" />
    <link href="~/css/simple-line-icons.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    <link href="~/css/daterangepicker.min.css" rel="stylesheet" />
    <link href="~/css/gauge.min.css" rel="stylesheet" />
    <link href="~/css/toastr.min.css" rel="stylesheet" />


    <style>
        .loading {
            top: 0;
            left: 0;
            z-index: 111;
            background-color: #000;
            opacity: 0.5;
            width: 100%;
            height: 100%;
            position: fixed;
            display: none;
        }

        #popup {
            top: 50%;
            left: 50%;
            z-index: 111;
            width: 300px;
            height: 200px;
            position: fixed;
            display: none;
        }
    </style>

</head>

<body>
    <div >
        <form asp-action="Login">
            <div class="logo">
                <img src="~/img/login_img.png" alt="Login img" />
                <div>
                    <span style="padding:0; margin-bottom:0; margin-top:0px; color:#91A1BF; display:inline-block; font-size:20px;">SyncOS</span>
                </div>
            </div>

            <div >
                <div style="padding:0; margin:0;">
                    <img src="~/img/icons/essential-pack/locked-4.png" width="32" height="32" alt="User add" style="margin-right:8px; vertical-align: top;" />
                    <h3 style="padding:0; margin-bottom:0; margin-top:0px; color:#91A1BF; display:inline-block;">Login</h3>
                </div>
                <div class="progress progress-xs mt-3 mb-0" style="margin-bottom: 1rem !important;">
                    <div class="progress-bar bg-secondary" role="progressbar" style="width:100%;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>


            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">E-Mail</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Senha</label>
                <input asp-for="PassWord" class="form-control" type="password" />
                <span asp-validation-for="PassWord" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>

            <div class="form-group">
                <a asp-area="" asp-controller="Home" asp-action="ForgotPassword">Esqueceu a senha?</a>
            </div>

            <div class="form-group">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Retornar</a>
            </div>
        </form>
    </div>

</body>
</html>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
