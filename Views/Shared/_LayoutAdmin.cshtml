    <!-- ME Login CSS -->
    <link href="~/css/melogin.css" />

    <!-- Material Icons -->
    <link href="~/css/material_icons.css" rel="stylesheet" />



    <style>
        .loading {
            top: 0;
            left: 0;
            z-index: 111;
            background-color: #000;
            opacity: 0.5;
            width: 100%;
            height: 100%;
            position: fixed;
            display: none;
        }

        .nav-item .subitem {
            padding-left: 40px;
        }

        .nav .nav-item .nav-dropdown-items .nav-item .subitem {
            padding-left: 40px;
        }

        #popup {
            top: 50%;
            left: 50%;
            z-index: 111;
            width: 300px;
            height: 200px;
            position: fixed;
            display: none;
        }

        .ui-datepicker {
            z-index: 1050 !important;
        }

        #itemConsultBut {
            position: relative;
            /*background-color: darkorange;*/
            background-color: seagreen;
            color: white;
            padding: 7px;
            border-radius: 20px;
            box-shadow: 0px 2px 5px grey;
        }

            #itemConsultBut:hover {
                background-color: lightseagreen;
            }

            #itemConsultBut:active {
                /*background-color: lightseagreen;*/
                top: 2px;
                box-shadow: 0px 0px 3px grey;
            }

        th {
            font-size: 13px;
        }

        td {
            font-size: 13px;
        }
    </style>
</head>



