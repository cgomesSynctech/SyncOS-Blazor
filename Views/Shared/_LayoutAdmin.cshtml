@using System.Globalization
@using System.IO


@{
    var perfil = int.Parse(ViewData["Perfil"].ToString());
}
@if (IsSectionDefined("AddToHead"))
{
    @RenderSection("AddToHead", required: false)
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
