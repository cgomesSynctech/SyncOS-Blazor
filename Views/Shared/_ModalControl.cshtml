<div class="modal fade" id="ConfirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-success modal-md" role="document">

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Confirmação</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="modal-body">
                <h5 id="modalMensagem"></h5>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-info" data-dismiss="modal"><i class="fa fa-times"></i> Fechar</button>

                <!-- Ok -->
                <button type="button" id="btModalConfirm" class="btn btn-success" style="color:white;"> Confirmar <i class="fa fa-check"></i></button>
            </div>

        </div>
    </div>
</div>
