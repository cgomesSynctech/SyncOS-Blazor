<style>
    .cheqField {
        font-size: 13px;
    }
</style>

<div hidden="hidden">
    <select id="selectContasDespesas" class="form-control">
        @foreach (SelectListItem contaDespesa in ViewBag.ContasContabeis)
        {
            <option value="@contaDespesa.Value">@contaDespesa.Text</option>
        }
    </select>
</div>

<div class="modal fade" id="TransModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-success modal-xl" role="document">

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Pagamento</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row" style="padding-left: 15px; padding-right: 15px;">

                    <div class="form-group row" style="padding-left: 15px; padding-right: 15px;">
                        <!-- NOME E TIPO DO FAVORECIDO -->
                        <label id="tipoFavorecidoTransacao"></label>
                        <span> - </span>
                        <label id="favorecido"></label>
                    </div>

                    <div class="form-group row">

                        <div class="col-md-7">

                            <div class="form-group row">
                                <!-- TOTAL DO PEDIDO -->
                                <div class="col-lg-6">
                                    <div>
                                        <label>Total do pedido</label>
                                    </div>
                                    <div>
                                        <span id="vTotal" style="font-weight: 500;">R$0,00</span>
                                    </div>
                                </div>
                                <!-- TOTAL DE ITENS -->
                                <div class="col-lg-6 itensCounter">
                                    <div>
                                        <label>Total de itens</label>
                                    </div>
                                    <div>
                                        <span id="tItens" style="font-weight: 500;">0</span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row">
                                <!-- VALOR A PAGAR -->
                                <div class="col-lg-6">
                                    <div>
                                        <label>Valor a pagar</label>
                                    </div>
                                    <div>
                                        <input type="text" id="vlrPagto" class="form-control form-control-sm moedaInput" />
                                    </div>
                                </div>
                                <!-- FORMAS DE PAGAMENTO -->
                                <div class="col-lg-6">
                                    <div>
                                        <label>Formas de pagamento</label>
                                    </div>
                                    <div>
                                        <select id="mFormaPag" class="form-control form-control-sm">
                                            <option value="0">Escolher...</option>
                                            <option value="01">Dinheiro</option>
                                            <option value="03">Cartão</option>
                                            <option value="02">Cheque</option>
                                            <option value="05">Credito Loja</option>
                                        </select>
                                    </div>
                                </div>
                            </div>


                            <!-- VALOR PAGA E PENDENTE -->
                            <div class="form-group row" id="divOK" style="display: none;">
                                <div class="col-lg-6">
                                    <div>
                                        <span id="txtOK" style="color:#79c447; font-weight: bold;"></span>
                                    </div>
                                </div>
                            </div>


                            <div class="form-group row" id="divPago">
                                <div class="col-lg-4">
                                    <div>
                                        <span id="vPago" style="color:#79c447; font-weight: bold;">R$0,00</span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div>
                                        <span style="color:#79c447; font-weight: bold;">Pago</span>
                                    </div>
                                </div>
                            </div>


                            <div class="form-group row" id="divPendente">
                                <div class="col-lg-4">
                                    <div>
                                        <span style="color:#ff5454; font-weight: bold;" id="vPendente">R$0,00</span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div>
                                        <span style="color:#ff5454; font-weight: bold;" id="pendenteTxt">Pendente</span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-md-5">

                            <!-- LISTA DE PAGAMENTOS-->
                            <p style="position:relative; top:15px;">Pagamentos</p>
                            <table id="pagtoTable" class="table table-bordered table-striped table-sm text-center">

                                <!--CABECALHO DA TABELA-->
                                <thead>
                                    <tr>
                                        <th>Forma</th>
                                        <th>Valor Pago</th>
                                        <th>Estornar</th>
                                    </tr>
                                </thead>


                                <tbody></tbody>

                            </table>

                        </div>
                    </div>

                </div>

                <div class="row" style="padding-left: 15px; padding-right: 15px;">
                    <div class="col-12 text-right">
                        <button id="addContaContabil" class="btn btn-success" style="color:white;">Add <i class="fa fa-plus" style="color:white;"></i></button>
                    </div>
                </div>

                <!-- LISTA DE CONTAS CONTÁBEIS-->
                <div class="row" style="height:25vh;padding-left: 15px; padding-right: 15px; padding-top: 5px">
                    <table id="contasContabeis" class="table table-responsive-sm table-bordered table-striped table-sm" style="overflow:auto;margin: 0px">
                        <thead class="table-dark">
                            <tr>
                                <th style='width:100px;' class='text-center'>Conta Contábil</th>
                                <th style='width:50px;'>Valor R$</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <!--ChequePanel-->
                <div hidden="hidden" id="chequePanel" class="row" style="display: block; margin:auto">
                    <hr />

                    <label style="margin-left: 15px"><b>Cheque</b></label>

                    <table id="tabelaCheques" class="table table-responsive-sm table-bordered table-striped table-sm" style="overflow:auto; margin-top: 0px; margin-bottom: 0px">
                        <thead class="thead-dark">
                            <tr>
                                <th>Titular</th>
                                <th>Número Cheque</th>
                                <th style="width:12%">Banco ID</th>
                                <th style="width:15%">Valor</th>
                                <th>Vencimento</th>
                            </tr>
                        </thead>

                        <tbody>
                            <!--POPULADO DINAMICAMENTE-->
                            <tr>
                                <td><input class='form-control cheqField' type='text' id='CheqTitular' /></td>
                                <td><input class='form-control cheqField' type='text' id='CheqNumero' /></td>
                                <td><input class='form-control cheqField' type='text' id='CheqIdBanco' /></td>
                                <td><input class='form-control cheqField text-right moedaInput' type='text' id='CheqValor' /></td>
                                <td><input class='form-control cheqField' type='date' id='CheqVencimento' /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- cliCreditoPanel -->
                <div hidden="hidden" id="cliCreditoPanel" class="row" style="display: block; margin:auto">
                    <hr />

                    <label style="margin-left: 15px">Crédito Loja </label>

                    <input readonly id="cliCredito" class="col-sm-3 ml-3 form-control" />

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" data-dismiss="modal"><i class="fa fa-times"></i> Fechar</button>
                <button style="color:white;" type="button" id="mPagar" class="btn btn-success" disabled>Pagar <i style="color:white;" class="fa fa-credit-card"></i></button>
                <button style="color:white; display:none;" type="button" id="mConfirmar" class="btn btn-success">Finalizar <i class="fa fa-check"></i></button>
            </div>

        </div>
    </div>
</div>

@*
    ~TRANSACAO~

    • OBS:
        - TRANSACAO é chamada pelo 'VALIDADOR DE SAIDA' (necessário validacoes de campos antes de chamar esta tela);

    • Variaveis JS Externas Necessarias:
        var totalGrl

    • Identificadores Externos:
        #FORM_TRANS (formulario)
        #table_itens (tabela de itens)
        #LISTA_PAGTOS (lista de pagamentos que vai para o modelo)
        #TRANSACAO (botao para chamar)

    • Identificadores Locais:
        [TransModal]
            favorecido
            vTotal
            tItens
            • vlrPagto
            • mFormaPag
            divOk (visualizacao)
            divPago (visualizacao)
            vPago
            divPendente (visualizacao)
            vPendente (valores negativos, muda o texto para TROCO)
            pendenteTxt (altera entre 'PENDENTE' e 'TROCO')
            pagtoTable
            chequePanel
            tabelaCheques
                CheqTitular
                CheqNumero
                CheqIdBanco
                CheqValor
                CheqVencimento
            • mPagar
            • mConfirmar(Submit) (HIDDEN)
*@