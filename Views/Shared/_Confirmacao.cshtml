<!-- Modal (ALTERADO PARA A TABELA SERVER/SIDE) -->
<div class="modal fade" id="confirmaModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">

        <!-- Conteúdo do modal -->
        <div id="modalConteudo" class="modal-content">
            <div class="modal-header">
                <h4 id="titulo"></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" style="color:#ffffff;">x</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="mensagem"></p>
            </div>
            <div class="modal-body modal-footer">
                <button id="cancelar" type="button" class="btn" data-dismiss="modal">Cancelar</button>
                <button id="confirmar" type="button" class="btn">Confirmar</button>
            </div>
        </div>

    </div>
</div>