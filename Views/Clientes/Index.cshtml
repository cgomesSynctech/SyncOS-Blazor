@using Services
@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
@model X.PagedList.IPagedList<Modelos.Cliente>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var sort = @ViewData["NameSortParm"];
    var filtro = @ViewData["Filtro"];
    var ativo = @ViewData["Ativo"];
    var perfil = int.Parse(ViewData["Perfil"].ToString());
}

<h2>Lista Clientes <a asp-action="Create"><img src="~/img/ic_add.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a></h2>
<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            <input type="text" name="Filtro" placeholder="consulta" value="@ViewData["Filtro"]" />
            <input type="submit" value="Pesquisa" class="btn btn-secondary bg-primary text-white" />
            <a asp-action="Index" asp-route-ativo=0 class="btn btn-secondary bg-primary text-white"> Sem Filtro </a>
            <a asp-controller="Clientes"
            asp-action="Index"
            asp-route-ativo=1 class="btn btn-secondary bg-primary text-white"> Apenas os Ativos </a>
            <a asp-controller="Clientes"
            asp-action="Index"
            asp-route-ativo=2 class="btn btn-secondary bg-primary text-white"> Apenas os Desativados </a>
            <a asp-controller="Clientes"
               asp-action="Index"
               asp-route-ativo=3 class="btn btn-secondary bg-primary text-white"> Com Pendencia Financeira </a>
            @*             <div class="col-md-3">
                <select id="setor" name="setor" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.SetorId" onchange="selectStatus()"></select>
            </div> *@
        </p>
    </div>
</form>
<table class="table table-responsive table-striped text-nowrap table-sm">
    <thead>
        <tr>
            <th style="text-align:right;">
                # ID
            </th>
            <th>
                Razão
            </th>
            <th>
                Fantasia
            </th>
            <th>
                CNPJ
            </th>
            <th>
                Contato
            </th>
            <th style="text-align:center;">
                Bloqueado
            </th>
            <th style="text-align:center;">
                Ativo
            </th>
            <th style="text-align:right;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var estilo = "";
            if (item.Bloqueado)
            {
                estilo = "table-warning";
            }
            if (item.Desativado)
            {
                estilo = "table-danger";
            }
            if (item.Pendencia)
            {
                estilo = "table-info";
            }

            var bloqueado = item.Bloqueado.Equals(true) ? "Sim" : "Não";
            var desativado = item.Desativado.Equals(true) ? "Não" : "Sim";
            var pendencia = item.Pendencia.Equals(true) ? "Sim" : "Não";
            <tr class=@estilo>
                <td style="text-align:right;">
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td class="text-truncate" style="max-width: 200px;">
                    @Html.DisplayFor(modelItem => item.Razao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Fantasia)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CPF_CNPJ)
                </td>
                <td class="text-truncate" style="max-width: 150px;">
                    @Html.DisplayFor(modelItem => item.Contato)
                </td>
                <td style="text-align:center;">
                    @bloqueado
                </td>
                <td style="text-align:center;">
                    @desativado
                </td>
                <td style="text-align:center;">
                    @pendencia
                </td>

                @if (perfil == 3)
                {
                    <td>
                        <a asp-action="Create" asp-controller="Chamados" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/plus.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        | <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/edit.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        | <a asp-action="Details" asp-controller="Clientes" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/info.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                    </td>
                }
                else
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/edit.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a> |
                        @if (item.Bloqueado.Equals(true))
                        {
                            <a asp-action="Bloqueio" asp-route-id="@item.Id"><img src="~/img/icons/user-pack/padlock-1.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a> 
                        }
                        else
                        {
                            <a asp-action="Bloqueio" asp-route-id="@item.Id"><img src="~/img/icons/user-pack/padlock-9.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        |
                        @if (item.Desativado.Equals(true))
                        {
                            <a asp-action="Ativar" asp-route-id="@item.Id"><img src="~/img/icons/user-pack/padlock-1.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        else
                        {
                            <a asp-action="Ativar" asp-route-id="@item.Id"><img src="~/img/icons/user-pack/padlock-9.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        | <a asp-action="Index" asp-controller="ClienteHistoricos" asp-route-clienteId="@item.Id"><img src="~/img/icons/essential-pack/folder-14.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a> 
                        | <a asp-action="Create" asp-controller="Chamados" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/plus.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        @if (item.Pendencia.Equals(true))
                        {
                            <a asp-action="PendenciaFinanceira" asp-route-clienteId="@item.Id"><img src="~/img/icons/business-pack/coins-1.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        else
                        {
                            <a asp-action="PendenciaFinanceira" asp-route-clienteId="@item.Id"><img src="~/img/icons/business-pack/money.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        <a asp-action="BaseControle" asp-route-clienteId="@item.Id"><img src="~/img/icons/essential-pack/app.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                        @if (!string.IsNullOrEmpty(item.TokenAtualiza))
                        {
                            <a asp-action="ZerarToken" asp-route-clienteId="@item.Id"><img src="~/img/icons/essential-pack/unlink.png" width="20" height="20" alt="Zerar Token" style="margin-right:8px; vertical-align: top;" /></a>
                        }
                        
                    </td>
                }

            </tr>
        }
    </tbody>
</table>
<div>
    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
</div>

@Html.PagedListPager(
    Model,
    pagina => Url.Action("Index", new { pagina, sortOrder = sort, currentFilter = filtro, ativo = ativo}),
    new PagedListRenderOptions
    {
    DisplayItemSliceAndTotal = false,
    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
    ContainerDivClasses = new[] { "navigation" },
    PageClasses = new[] { "page-link" },
    LiElementClasses = new[] { "page-item" },
    UlElementClasses = new[] { "pagination justify-content-left" }
    }
    )