@using System.Globalization;
@model Modelos.Cliente

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var bloqueado = ViewData["Bloqueado"];
    var desativado = ViewData["Desativado"];
}

<html lang="pt-br">
<body>
    <h2>Alterar Cliente</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Bloqueado" value="@bloqueado" />
                <input type="hidden" asp-for="Desativado" value="@desativado"/>
                <div class="form-group">
                    <label class="control-label">Revenda</label>
                    <select asp-for="RevendaId" class="form-control" asp-items="ViewBag.RevendaId"></select>
                </div>
                <div class="form-group">
                    <label class="control-label">Razão Social</label>
                    <input asp-for="Razao" class="form-control" />
                    <span asp-validation-for="Razao" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Nome Fantasia</label>
                    <input asp-for="Fantasia" class="form-control" />
                    <span asp-validation-for="Fantasia" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="control-label">CNPJ</label>
                            <input asp-for="CPF_CNPJ" class="form-control" />
                            <span asp-validation-for="CPF_CNPJ" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="control-label">Inscrição Estadual</label>
                            <input asp-for="InscricaoEstadual" class="form-control" />
                            <span asp-validation-for="InscricaoEstadual" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">Contato</label>
                    <input asp-for="Contato" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="control-label">Endereço</label>
                    <input asp-for="Endereco" class="form-control" />
                    <span asp-validation-for="Endereco" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <label asp-for="Bairro" class="control-label"></label>
                            <input asp-for="Bairro" class="form-control" />
                            <span asp-validation-for="Bairro" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CEP" class="control-label"></label>
                            <input asp-for="CEP" class="form-control" />
                            <span asp-validation-for="CEP" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label asp-for="Numero" class="control-label"></label>
                            <input asp-for="Numero" class="form-control" />
                            <span asp-validation-for="Numero" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label a class="control-label">UF</label>
                            <select asp-for="UFId" class="form-control" asp-items="ViewBag.UFId" id="uf"></select>
                        </div>
                        <div class="col-md-4">
                            <label  class="control-label">Municipio</label>
                            <select asp-for="MunicipioId" class="form-control" asp-items="ViewBag.MunicipioId" id="municipio"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">Valor Manutenção</label>
                            <input asp-for="ValorContrato" class="form-control" id="valorcontrato" oninput="replaceValorContrato()" />
                            <span asp-validation-for="ValorContrato" class="text-danger"></span>

                        </div>
                        <div class="col-md-4">
                            <label class="control-label">Valor Backup</label>
                             <input asp-for="ValorContratoBackup" class="form-control" id="valorcontratobackup" oninput="replaceValorContratoBackup()" />
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">Latitude e Longitude</label>
                            <input asp-for="LatitudeLongitude" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">WhatsApp</label>
                            <input asp-for="WhatsApp" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="control-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-8">
                            <label class="control-label">Resp_Nome</label>
                            <input asp-for="Resp_Nome" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">Resp_CPF</label>
                            <input asp-for="Resp_CPF" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label">Resp Endereço</label>
                    <input asp-for="Resp_Endereco" class="form-control" />
                </div>

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="control-label">Resp Numero</label>
                            <input asp-for="Resp_Numero" class="form-control" />
                            <span asp-validation-for="Resp_Numero" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label a class="control-label">Resp UF</label>
                            <input asp-for="Resp_UF" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label a class="control-label">Resp Cidade</label>
                            <input asp-for="Resp_Cidade" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label a class="control-label">Resp CEP</label>
                            <input asp-for="Resp_CEP" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">Chave FlexDocs</label>
                    <input asp-for="ChaveFlexDocs" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Chave CSC </label>
                    <input asp-for="ChaveCSC" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Chave Manifesto</label>
                    <input asp-for="ChaveManifesto" class="form-control" />
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input asp-for="Retaguarda" /> @Html.DisplayNameFor(model => model.Retaguarda)
                        </label>
                        <label>
                            <input asp-for="Nf" /> @Html.DisplayNameFor(model => model.Nf)
                        </label>
                        <label>
                            <input asp-for="Nfc" /> @Html.DisplayNameFor(model => model.Nfc)
                        </label>
                        <label>
                            <input asp-for="MDF" /> @Html.DisplayNameFor(model => model.MDF)
                        </label>
                        <label>
                            <input asp-for="VipShop" /> @Html.DisplayNameFor(model => model.VipShop)
                        </label>
                        <label>
                            <input asp-for="VipShop" /> @Html.DisplayNameFor(model => model.VipShop)
                        </label>
                    </div>
                </div>

                <div class="checkbox">
                    <label>
                        <input asp-for="Sped" /> @Html.DisplayNameFor(model => model.Sped)
                    </label>
                    <label>
                        <input asp-for="Backup" /> @Html.DisplayNameFor(model => model.Backup)
                    </label>
                    <label>
                        <input asp-for="TEF" /> @Html.DisplayNameFor(model => model.TEF)
                    </label>
                    <label>
                        <input asp-for="Certificado" /> @Html.DisplayNameFor(model => model.Certificado)
                    </label>
                    <label>
                        <input asp-for="Outros" /> @Html.DisplayNameFor(model => model.Outros)
                    </label>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="control-label">Especificação Outros </label>
                            <input asp-for="EspecieOutros" class="form-control" />
                            <span asp-validation-for="EspecieOutros" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                        </div>
                        <div class="col-md-6">
                            <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
@section Scripts {
<script>
        function replaceValorContrato(){
            var input = document.getElementById("valorcontrato");
            var valor = input.value;
            valor = valor.replace(".",",")
            input.value = valor;
        }
        function replaceValorContratoBackup() {
            var input = document.getElementById("valorcontratobackup");
            var valor = input.value;
            valor = valor.replace(".", ",")
            input.value = valor;
        }
        $(document).ready(function () {
            $("#uf").change(function () {
                var uf = $(this).val();
                $.ajax({
                    type: "POST",
                    url: "/Clientes/FiltraMunicipio",
                    data: { uf: uf },
                    dataType: "json",
                    success: function (cities) {

                        //console.log(cities);
                        $("#municipio").empty();
                        //$("#municipio").append("<option value='00000000'>Selecione um Municipio</option>");
                        for (var i = 0; i < cities.length; i++) {
                            $("#municipio").append("<option value=\'" + cities[i].id + "\'>" + cities[i].desc_UF + "</option>");
                        }

                    },
                    error: function () {
                        alert("Erro ao carregar cidades.");
                    }
                });
            });
        });


</script>

}
