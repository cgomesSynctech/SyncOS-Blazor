﻿@using X.PagedList.Mvc.Core;
@using X.PagedList.Web.Common;
@model X.PagedList.IPagedList<Modelos.DesenvCard>
@section AddToHead {

<style type="text/css">
    .pop-outer {
    background-color: rgba(0, 0, 0, 0.5);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    }

    .pop-inner {
    z-index: 1000;
    margin: 300px auto;
    padding: 10px;
    width: 148px;
    background-color: White;
    border-radius: 10px;
    filter: alpha(opacity=100);
    opacity: 1;
    -moz-opacity: 1;
    }

    .pop-inner img {
    height: 128px;
    width: 128px;
    }
</style>
}
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var status = int.Parse(ViewData["Status"].ToString());
    var modulo = int.Parse(ViewData["Modulo"].ToString());
}
<h2>Solicitações Desenvolvimento <a asp-action="Create"><img src="~/img/ic_add.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a></h2>
<form asp-action="Index" method="get" id="chamado" name="chamado">
    <div class="form-group">
        <div class="row">
            <div class="col-md-1">
                <span class="input-group-text"><strong>Status:</strong> </span>
            </div>
            <div class="col-md-3">
                <select id="status" name="status" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.DesenvCardStatusId" onchange="selectStatus()"></select>
            </div>
            <div class="col-md-1">
                <span class="input-group-text"><strong>Módulo:</strong> </span>
            </div>
            <div class="col-md-3">
                <select id="modulo" name="modulo" class="form-control text-truncate" style="max-width: 280px;" asp-items="ViewBag.ChamadoModuloId" onchange="selectStatus()"></select>
            </div>

        </div>
    </div>
</form>
<hr />

<div style="display: none;" class="pop-outer">
    <div class="pop-inner">
        <img alt="" src="~/gifs/progress.gif" />
    </div>
</div>

<table class="table table-responsive table-striped text-nowrap table-sm">
    <thead>
        <tr>
            <th style="text-align:center;">
                # Chamado
            </th>
            <th>
                Data Abertura
            </th>
            <th>
                Modulo
            </th>
            <th>
                Rotulo
            </th>
            <th>
                Status
            </th>
            <th>
                Solicitante
            </th>
            <th>
                Cliente
            </th>
            <th>
                Arquivo
            </th>
            <th>
                Ações
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var exibicao = item.Rotulo?.Length > 40 ? item.Rotulo.Substring(0, 40) + "..." : item.Rotulo;
            <tr >
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Data)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChamadoModulo.Descricao)
                </td>
                <td>
                    @exibicao                   
                    
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.DesenvCardStatus.Descricao)
                </td>
                <td>                    
                    @Html.DisplayFor(modelItem => item.Usuario.LoginName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClienteNome)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Arquivo))
                    {
                        <a href="~/desenvcard/@item.Arquivo" target="_blank">
                            @item.Arquivo
                        </a>
                    }
                    else
                    {
                        <span>Sem arquivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/img\icons\newIcons\Edit.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a> |
                    <a asp-action="Details" asp-route-id="@item.Id"><img src="~/img/icons/essential-pack/hide.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a>
                    <a asp-action="Index" asp-controller="DesenvCardHistorico" asp-route-desenvCardId="@item.Id"><img src="~/img/icons/business-pack/price-tag-7.png" width="20" height="20" alt="ativar" style="margin-right:8px; vertical-align: top;" /></a>
                    <a asp-action="AlteraStatus" asp-controller="Desev" asp-route-desenvcardId="@item.Id"><img src="~/img/icons/essential-pack/pin.png" width="20" height="20" alt="desativar" style="margin-right:8px; vertical-align: top;" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
</div>

@Html.PagedListPager(
            Model,
            pagina => Url.Action("Index", new { pagina, status, modulo }),
            new PagedListRenderOptions
        {
            DisplayItemSliceAndTotal = false,
            DisplayEllipsesWhenNotShowingAllPageNumbers = true,
            ContainerDivClasses = new[] { "navigation" },
            PageClasses = new[] { "page-link" },
            LiElementClasses = new[] { "page-item" },
            UlElementClasses = new[] { "pagination justify-content-left" }
        }
            )
<script>
    function selectStatus() {
        $('.pop-outer').fadeIn('slow');
        var id = document.getElementById("status");
        var moduloId = document.getElementById("modulo");
        id.value = id.value.toUpperCase();
        $.ajax({
            type: "GET",
            url: "/Desev/Index",
            data: "pagina=0&status=" + id.value + "&" + moduloId.value,
            success: function (status) {
                document.getElementById("chamado").submit();
            },
            error: function () {
                alert("Erro ao selecionar status.");
            }
        });
    }

    function showModal() {
        $('.pop-outer').fadeIn('slow');
    }

    function hideModal() {
        $('.pop-outer').fadeOut('slow');
    }

    window.onload = function () {
        hideModal();
    }

    $(document).ready(function () {

    });

</script>

