@model Modelos.DesenvCard

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    
}



<hr />
<h4>Nova Solicitação de Desenvolvimento</h4>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <form id="upload" name="upload" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <input type="file" name="file" value="Selecionar">
                    <button type="submit">Enviar</button>
                </div>

            </form>
        </div>
        <form asp-action="Create" id="formPrincipal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UsuarioId" value="@Model.UsuarioId" />
            <input type="hidden" asp-for="Data" value="@Model.Data" />
            <input type="hidden" asp-for="DesenvCardStatusId" value="@Model.DesenvCardStatusId" />

            <div class="col-md-6">
                <label asp-for="Arquivo" class="control-label"></label>
                <input asp-for="Arquivo" class="form-control" id="pct" readonly="true" />

            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label">Modulo</label>
                        <select asp-for="ChamadoModuloId" class="form-control" asp-items="ViewBag.ChamadoModuloId"></select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label">Cliente</label>
                        <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.Cliente">
                            <option value="">Não informado...</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">Rotulo</label>                
                <input asp-for="Rotulo" class="form-control" />
                <span asp-validation-for="Rotulo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Descricao Problema</label>
                <textarea asp-for="Descricao" type="text" class="form-control" rows="5" id="MessageInputField" autofocus></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Detalhes" class="control-label"></label>
                <textarea asp-for="Detalhes" type="text" class="form-control" rows="5" id="MessageInputField" autofocus></textarea>
                <span asp-validation-for="Detalhes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label"># Observacao</label>
                <textarea asp-for="Observacao" type="text" class="form-control" rows="5" id="MessageInputField" autofocus></textarea>
                <span asp-validation-for="Observacao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Link Base de Dados</label>
                <input asp-for="LinkBase" class="form-control" />
                <span asp-validation-for="LinkBase" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                    </div>
                    <div class="col-md-6">
                        <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {

            $("#upload").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/Desev/UploadArquivo",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#formPrincipal input[name='Arquivo']").val(response.success);
                        alert("Arquivo " + response.success + ", enviado com sucesso!");
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {

            $("#upload").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/Desev/UploadArquivosol",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#formPrincipal input[name='Arquivo']").val(response.success);
                        alert("Arquivo " + response.success + ", enviado com sucesso!");
                    }
                });
            });
        });
    </script>

}

<h4>Nova Solicitação de Desenvolvimento</h4>


