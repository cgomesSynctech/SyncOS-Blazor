
@{

    var perfil = int.Parse(ViewData["Perfil"].ToString());

    var usuario = ViewData["NomeUsuario"].ToString();
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var dataAtual = DateTime.UtcNow;

    var titulos = ViewBag.Titulos;
    var valores = ViewBag.Valores;
    var titulosGraf = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(titulos));
    var valoresGraf = Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(valores));
}



<div class="row">
    <div class="col-md-6">
        <h1 class="page-title txt-color-blueDark">
            Bem vindo, @usuario
        </h1>
    </div>
</div>
<hr />
<div class="row">

    @if (perfil == 1 || perfil == 2)
    {
        <div class="col-md-4 border border-primary border-5 px-2">
            <div class="panel panel-senhadia panel-primary" data-toggle="tooltip" data-placement="right" title="DATA ATUAL DO SERVIDOR @dataAtual">
            <div class="panel-heading">
                <h3 class="panel-title">
                    Senha do Dia
                </h3>
            </div>
            <form asp-action="SenhaDia" asp-controller="HomeAdmin" id="SenhaDia" name="SenhaDia" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-4 panel-footer text-align-center">
                            <input type="text" name="SenhaDiaTxt" placeholder="Senha do dia" class="form-control" />
                    </div>
                    <div class="col-md-2 panel-footer text-align-center">
                        <button type="submit" class="btn btn-primary">Gerar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-2 panel-footer text-align-center">
    </div>
    }

    <div class="col-md-4 border border-primary border-5 px-2">
        <div class="panel panel-senhadia panel-primary" data-toggle="tooltip" data-placement="right" title="DATA ATUAL DO SERVIDOR @dataAtual">
            <div class="panel-heading">
                <h3 class="panel-title">
                    Senha Download XML <strong>(NFCe)</strong>
                </h3>
            </div>
            <form asp-action="SenhaDiaXML" asp-controller="HomeAdmin" id="SenhaDiaXML" name="SenhaDia" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-4 panel-footer text-align-center">
                        <input type="text" name="SenhaDiaXMLTxt" placeholder="Senha do dia" class="form-control" />
                    </div>
                    <div class="col-md-2 panel-footer text-align-center">
                        <button type="submit" class="btn btn-primary">Gerar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<hr />
<h2>Chamdos abertos últimos 6 meses</h2>
<div class="w-75 p-3 h-25 d-inline-block">
    <canvas id="myChart"></canvas>
</div>
@*<div style="display: none;" class="pop-outer">
    <div class="pop-inner">
        <img alt="" src="~/gifs/progress.gif" />
    </div>
</div>*@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var valores = @valoresGraf;
    var titulos = @titulosGraf;
    const ctx = document.getElementById('myChart');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: titulos,
            datasets: [{
                label: '# Abertoss',
                data: valores,
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#SenhaDia").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/HomeAdmin/SenhaDia",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#SenhaDia input[name='SenhaDiaTxt']").val(response.success);
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $("#SenhaDiaXML").submit(function (event) {
                if (!this.checkValidity()) {
                    return;
                }
                event.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: "/HomeAdmin/SenhaDiaXML",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        $("#SenhaDiaXML input[name='SenhaDiaXMLTxt']").val(response.success);
                    }
                });
            });
        });




    </script>
}

