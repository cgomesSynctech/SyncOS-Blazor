@model Modelos.Usuario

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Alterar Senha</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AlterarSenha" asp-controller="Usuarios">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PerfilId" />
            <div class="form-group">
                <label class="control-label">Nome Usuário</label>
                <input asp-for="LoginName" class="form-control" readonly="true"/>

            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" readonly="true" />
            </div>

            <div class="form-group">
                <label  class="control-label">Nova Senha</label>
                <input asp-for="LoginPass" class="form-control" value="" type="password"/>
            </div>

            <div class="form-group">
                <label  class="control-label">Confirma Senha</label>
                <input asp-for="ConfirmePass" class="form-control" type="password" />
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <input type="submit" value="Salvar" class="btn btn-success btn-sm" />
                    </div>
                    <div class="col-md-6">
                        <a asp-action="Index" class="btn btn-light btn-sm">Retornar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>




