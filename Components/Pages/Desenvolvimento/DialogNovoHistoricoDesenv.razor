@inject IDbContextFactory<APPDbContext> DbFactory
@inject ISnackbar Snackbar
@inject AuthService Auth

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.AddComment" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">Nova Anotação no Card #@CardId</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3">
            <b>Rótulo:</b> @RotuloCard
        </MudText>

        <MudTextField @bind-Value="descricao"
                      Label="Título / Assunto *"
                      Placeholder="Resumo da atualização ou teste..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="detalhes"
                      Label="Detalhes da Atividade / Código / Teste"
                      Placeholder="Descreva as alterações técnicas realizadas, branchs ou resultados de testes..."
                      Variant="Variant.Outlined"
                      Lines="4"
                      Class="mb-3" />

        <MudTextField @bind-Value="linkBase"
                      Label="Link de Referência / Git Commit / Chamado"
                      Placeholder="https://github.com/..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@salvando">
            @if (salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Salvando...</span>
            }
            else
            {
                <span>Adicionar Histórico</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public int CardId { get; set; }
    [Parameter] public string RotuloCard { get; set; }
    [Parameter] public int StatusAtualId { get; set; }

    private string descricao = "";
    private string detalhes = "";
    private string linkBase = "";
    private bool salvando = false;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(descricao))
        {
            Snackbar.Add("Informe o título/assunto do histórico.", Severity.Warning);
            return;
        }

        salvando = true;
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var historico = new DesenvCardHistorico
            {
                DesenvCardId = CardId,
                DesenvCardStatusId = StatusAtualId > 0 ? StatusAtualId : 1,
                UsuarioId = Auth.CurrentUser?.Id ?? 1,
                Data = DateTime.Now,
                Descricao = descricao.Trim(),
                Detalhes = detalhes?.Trim() ?? "",
                LinkBase = linkBase?.Trim() ?? ""
            };

            ctx.DesenvCardHistorico.Add(historico);
            await ctx.SaveChangesAsync();

            Snackbar.Add("Histórico adicionado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar histórico: {ex.Message}", Severity.Error);
        }
        finally
        {
            salvando = false;
        }
    }
}
