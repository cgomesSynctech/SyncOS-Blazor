@inject IDbContextFactory<APPDbContext> DbFactory
@inject ISnackbar Snackbar
@inject AuthService Auth

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">Alterar Status do Card #@CardId</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-3">
            <b>Rótulo:</b> @RotuloCard
        </MudText>

        <MudSelect T="int" @bind-Value="novoStatusId" Label="Novo Status de Desenvolvimento *" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-4">
            @foreach (var s in statusList)
            {
                <MudSelectItem Value="@s.Id">@s.Descricao</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="observacao"
                      Label="Observação / Justificativa"
                      Placeholder="Descreva o motivo da alteração de status..."
                      Variant="Variant.Outlined"
                      Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@salvando">
            @if (salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Atualizando...</span>
            }
            else
            {
                <span>Salvar Alteração</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public int CardId { get; set; }
    [Parameter] public string RotuloCard { get; set; }
    [Parameter] public int StatusAtualId { get; set; }

    private int novoStatusId;
    private string observacao = "";
    private bool salvando = false;
    private List<DesenvCardStatus> statusList = new();

    protected override async Task OnInitializedAsync()
    {
        novoStatusId = StatusAtualId;
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            statusList = await ctx.DesenvCardStatus
                .AsNoTracking()
                .Where(s => s.Id > 0 && s.Id != 100 && s.Id != 9)
                .OrderBy(s => s.Id)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar status: {ex.Message}", Severity.Error);
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        if (novoStatusId == StatusAtualId && string.IsNullOrWhiteSpace(observacao))
        {
            Snackbar.Add("Selecione um status diferente ou informe uma observação.", Severity.Warning);
            return;
        }

        salvando = true;
        try
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var card = await ctx.DesenvCard.FindAsync(CardId);
            if (card == null)
            {
                Snackbar.Add("Card não encontrado.", Severity.Error);
                return;
            }

            var statusAntigo = statusList.FirstOrDefault(s => s.Id == card.DesenvCardStatusId)?.Descricao ?? "Inicial";
            var statusNovo = statusList.FirstOrDefault(s => s.Id == novoStatusId)?.Descricao ?? "Novo";

            card.DesenvCardStatusId = novoStatusId;

            var historico = new DesenvCardHistorico
            {
                DesenvCardId = CardId,
                DesenvCardStatusId = novoStatusId,
                UsuarioId = Auth.CurrentUser?.Id ?? 1,
                Data = DateTime.Now,
                Descricao = $"Status alterado de '{statusAntigo}' para '{statusNovo}' por {Auth.CurrentUser?.LoginName ?? "Sistema"}.",
                Detalhes = observacao,
                Observacao = observacao
            };

            ctx.DesenvCardHistorico.Add(historico);
            await ctx.SaveChangesAsync();

            Snackbar.Add("Status atualizado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao atualizar status: {ex.Message}", Severity.Error);
        }
        finally
        {
            salvando = false;
        }
    }
}
